# Storage root for uploaded videos (jobs/<video_id>/).
DATA_DIR=data

# Upload limits
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=7200
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=3840
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=600

# Media binaries (defaults: ffprobe/ffmpeg on PATH)
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg
