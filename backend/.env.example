# Storage root for uploaded videos (jobs/<video_id>/).
DATA_DIR=data

# Upload limits
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=7200
# Local upload resolution ceiling (YouTube downloads are capped at 1080p in code).
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=3840
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=600

# Clip generation
CLIP_TARGET_DURATION_SECONDS=60
CLIP_MIN_TAIL_MERGE_SECONDS=10
FFMPEG_CLIP_TIMEOUT_SECONDS=300
# Timeout for whole-source analysis passes (face sampling, scene detection).
ANALYSIS_TIMEOUT_SECONDS=1800
MAX_PROCESSING_QUEUE_SIZE=10
DISK_SPACE_SAFETY_MARGIN_BYTES=104857600

# Media binaries (defaults: ffprobe/ffmpeg on PATH)
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg
